# ==============================================================================
# FitKarma Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY RULE:
# Only PUBLIC client variables may be loaded by the Flutter mobile client.
# PRIVILEGED SERVER SECRETS MUST NEVER BE COMMITTED OR INJECTED INTO CLIENT BUILDS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT PUBLIC CONFIGURATION (Safe for mobile application)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=FitKarma
APP_PACKAGE_ID=com.sulekhniwal.fitkarma

# Supabase Public Endpoint (Public URL & Anon Key for RLS-governed client access)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key-subject-to-rls

# Observability (Public Client Sentry DSN with PII scrubbing enabled)
SENTRY_DSN=https://public@sentry.io/placeholder-dsn

# ------------------------------------------------------------------------------
# 2. PRIVILEGED SERVER SECRETS (SERVER-SIDE ONLY: Supabase Edge Functions / Vault)
# DO NOT ADD THESE VALUES TO LOCAL CLIENT .env OR DART DEFINE FLAGS
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=NEVER_ADD_TO_CLIENT
# RAZORPAY_KEY_ID=NEVER_ADD_TO_CLIENT
# RAZORPAY_KEY_SECRET=NEVER_ADD_TO_CLIENT
# RAZORPAY_WEBHOOK_SECRET=NEVER_ADD_TO_CLIENT
# GROQ_API_KEY=NEVER_ADD_TO_CLIENT
# WHATSAPP_ACCESS_TOKEN=NEVER_ADD_TO_CLIENT
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=NEVER_ADD_TO_CLIENT
