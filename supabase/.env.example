# ==============================================================================
# FitKarma Supabase Backend Environment Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT ANY REAL KEYS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL SUPABASE STACK (Default values generated by `npx supabase start`)
# ------------------------------------------------------------------------------
SUPABASE_ENV=local
SUPABASE_PROJECT_ID=fitkarma
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Standard local CLI anon key (public - used by client for RLS requests)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder_local_anon_key

# ------------------------------------------------------------------------------
# 2. PRIVILEGED SERVER SECRETS (SERVER-SIDE / EDGE FUNCTIONS ONLY)
# NEVER EXPOSE THESE VALUES TO THE FLUTTER CLIENT APP
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=placeholder_local_service_role_key
# GROQ_API_KEY=gsk_placeholder_local_groq_key
# RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
# RAZORPAY_KEY_SECRET=placeholder_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=placeholder_test_webhook_secret
# WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_token
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_verify_token
